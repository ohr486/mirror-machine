{
  "name": "MirrorMachine",
  "dockerComposeFile": "../docker-compose.yml",
  "service": "devcontainer",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "ms-vscode.vscode-typescript-next"
      ]
    }
  },
  "containerEnv": {
    "AWS_ENDPOINT_URL": "http://minio:9000",
    // WARNING: These are MinIO default credentials for local development only.
    // NEVER commit real AWS credentials to this file. For production environments,
    // use IAM roles or environment-specific credential management.
    "AWS_ACCESS_KEY_ID": "minioadmin",
    "AWS_SECRET_ACCESS_KEY": "minioadmin",
    "AWS_REGION": "ap-northeast-1",
    "NODE_ENV": "development"
  },
  "updateContentCommand": "npm install",
  "postStartCommand": "bash .devcontainer/post-start.sh",
  "forwardPorts": [3000, 9000, 9001]
}
